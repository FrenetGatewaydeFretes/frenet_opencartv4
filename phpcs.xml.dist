<?xml version="1.0"?>
<ruleset name="Frenet OpenCart 4">
    <description>Keeps the extension runnable on every PHP version OpenCart 4 stores use, from 8.0 to 8.5.</description>

    <file>system/library/frenet</file>
    <file>admin/controller/shipping/frenet.php</file>
    <file>catalog/controller/shipping/frenet.php</file>
    <file>catalog/model/shipping/frenet.php</file>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="testVersion" value="8.0-"/>
    <rule ref="PHPCompatibility"/>
</ruleset>
