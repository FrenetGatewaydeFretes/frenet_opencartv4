{% if token_required %}
<div class="alert alert-warning" id="frenet-token-required"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_token_required }} <a href="{{ panel_url|escape }}" target="_blank" rel="noopener noreferrer">{{ text_panel }}</a></div>
{% endif %}
{% if geo_zone_missing %}
<div class="alert alert-warning" id="frenet-geo-zone-missing"><i class="fa-solid fa-triangle-exclamation"></i> {{ text_geo_zone_missing }}</div>
{% endif %}
